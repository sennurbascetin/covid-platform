# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# --- Snowflake (optional) ---
# Leave blank to run entirely from the bundled Parquet snapshot.
# Account identifier: Snowsight -> profile (bottom-left) -> Account
# -> hover over the account -> Copy account identifier.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=YOUR_SNOWFLAKE_USERNAME
SNOWFLAKE_PRIVATE_KEY_FILE=secrets/rsa_key.p8
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=COVID19_EPIDEMIOLOGICAL_DATA
SNOWFLAKE_SCHEMA=PUBLIC

# --- MongoDB (runs as a local Docker container) ---
# Pick any password; letters, digits and underscore only - special
# characters like @ : / % break the connection URI.
MONGO_PASSWORD=choose_a_password_here
